<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="%PYTHONEXE%" 
                  arguments="-m gunicorn --bind=0.0.0.0:%HTTP_PLATFORM_PORT% barberia.wsgi:application" 
                  stdoutLogEnabled="true" 
                  stdoutLogFile="%HOME%\LogFiles\python-console.log">
    </httpPlatform>
  </system.webServer>
</configuration>
